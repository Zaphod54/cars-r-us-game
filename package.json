{
  "name": "cars-r-us-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build --config vite.standalone.config.js && vite build && mkdir -p dist/standalone && cp standalone/game.bundle.js dist/standalone/game.bundle.js",
    "bundle": "vite build --config vite.standalone.config.js",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "three": "^0.164.1",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "playwright": "^1.43.1"
  }
}
